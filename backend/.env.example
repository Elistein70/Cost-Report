# Database
DATABASE_URL=sqlite:///./cleardoh.db
# For PostgreSQL: postgresql://user:password@localhost/cleardoh

# App Settings
APP_NAME=ClearDOH
DEBUG=True
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
TEMPLATE_DIR=./templates

# Auto-tagging confidence threshold
CONFIDENCE_THRESHOLD=0.92

# File size limits (in MB)
MAX_FILE_SIZE=50
